# Copy to .env.local for local dev. In production these are set in Vercel.
# The VITE_ prefixed values are safe to expose to the browser.

# Supabase (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which Orchestrate sub-brand this deployment is. Tags every signup so the
# shared identity pool stays filterable by brand. Defaults to 'batchlabel'.
VITE_ORCHESTRATE_BRAND=batchlabel

# Meta Pixel (dataset) id. PUBLIC by design: it ships inside the page and anyone
# can read it out of the network tab, which is why the VITE_ prefix is correct
# here. Leave blank and the Pixel is inert — the site runs unchanged.
VITE_META_PIXEL_ID=

# Local development only. "true" loads the Pixel on localhost so it can be seen
# in Meta's Test Events tool without deploying. Anything else, including "1",
# leaves it off. Never set this in a deployed environment.
VITE_META_PIXEL_DEBUG=

# Shows the "Continue with Google" button. Hidden unless this is exactly "true",
# so the button cannot go live before the Google provider is enabled in Supabase.
# See docs/GOOGLE_OAUTH_SETUP.md.
VITE_GOOGLE_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# SERVER ONLY. Read by the Vercel Functions in /api, never by the browser.
# There is no VITE_ prefix on any of these on purpose: a VITE_ variable is
# inlined into the JavaScript bundle at build time, and every value below would
# be a full compromise if it were.
#
# For local development these are read by `vercel dev` (which serves /api).
# `npm run dev` runs Vite alone and does not serve the API routes at all.
# Setup instructions: docs/STRIPE_SETUP.md
# ---------------------------------------------------------------------------

# Stripe secret key. sk_test_... locally, sk_live_... in production.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. Locally this is the whsec_ value that
# `stripe listen` prints, NOT the one in the dashboard. Without it the webhook
# returns 500 and processes nothing, which is deliberate.
STRIPE_WEBHOOK_SECRET=

# The two Maker price ids from the Stripe product catalogue. Both stored
# VAT-inclusive for consumers.
STRIPE_PRICE_MAKER_MONTHLY=
STRIPE_PRICE_MAKER_ANNUAL=

# Supabase service role key. Bypasses row level security entirely - it is what
# lets the webhook write entitlements a browser can never touch.
SUPABASE_SERVICE_ROLE_KEY=
# Same value as VITE_SUPABASE_URL; the server-only alias is preferred if set.
SUPABASE_URL=

# Meta Conversions API access token. SECRET — a system-user token that can write
# events into the dataset. It must NEVER be VITE_ prefixed: a VITE_ variable is
# inlined into the browser bundle, and this is a public marketing site.
#
# In Vercel this is set in PRODUCTION ONLY, deliberately. A preview deployment
# forwarding real Purchase events would put fictional sales into Events Manager
# and into ad optimisation, and they cannot be removed. No token means no send —
# there is no fallback and none should be added. See docs/META_CAPI_SETUP.md.
META_CAPI_ACCESS_TOKEN=

# Optional. Routes Conversions API events to the Test Events tab instead of the
# live dataset. Set it while verifying; never leave it set in production, or real
# conversions become invisible to ad optimisation.
META_TEST_EVENT_CODE=

# Optional. Server-side alias for the pixel id; falls back to VITE_META_PIXEL_ID.
META_PIXEL_ID=

# Optional. Where checkout returns when the caller's origin is not recognised.
# Defaults to https://www.batchlabel.xyz
SITE_URL=

# Optional. Extra comma-separated CORS origins allowed to call the billing
# endpoints, e.g. a preview deployment of the product app repo.
STRIPE_ALLOWED_ORIGINS=

# Where the product app lives, for the post-login handoff. Defaults to
# https://app.batchlabel.xyz. Only set this to point at a local app instance —
# note it changes what the handoff tests assert against.
VITE_APP_URL=
