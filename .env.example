# Copy to .env.local for local dev. In production these are set in Vercel.
# The VITE_ prefixed values are safe to expose to the browser.

# Supabase (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which Orchestrate sub-brand this deployment is. Tags every signup so the
# shared identity pool stays filterable by brand. Defaults to 'batchlabel'.
VITE_ORCHESTRATE_BRAND=batchlabel

# Shows the "Continue with Google" button. Hidden unless this is exactly "true",
# so the button cannot go live before the Google provider is enabled in Supabase.
# See docs/GOOGLE_OAUTH_SETUP.md.
VITE_GOOGLE_AUTH_ENABLED=false
